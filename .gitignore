# ============================================================
# PlatformIO 构建产物（可再生成，不入库）
# ============================================================
.pio/
.cache/
# 5.1MB；可用 `pio run -t compiledb` 重新生成
compile_commands.json
*.pyc
__pycache__/

# ============================================================
# IDE / 编辑器
# ============================================================
.vscode/
.idea/
*.code-workspace

# ============================================================
# 操作系统
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 串口 / 运行日志（本地产物，不入库）
# ============================================================
serial*.log
*.log

# ★ 例外：`docs/evidence/**` 下的**非串口**日志应入库
#   否则证据 README 里"已归档"的声明与仓库事实不符
#   （2026-10-21 发现：G4-2026-10-20 的 6 个 .log 全部未入库，只进了 .bin / README）。
#   ⚠️ 例外必须写在 `*.log` 之后，否则前面的规则会先生效。
!docs/evidence/**/*.log

# ★ 但串口 dump 仍然排除：可能包含 WiFi/MQTT 凭据、内网地址等，
#   属本机敏感产物 ⇒ 只在其出现的那一轮 README 里写明"本机留存、不入库"。
docs/evidence/**/*serial*.log

# ============================================================
# LittleFS 源目录
#   含真实 MQTT 凭据（host / port / 用户名 / 密码）
#   ⚠️ 本规则只对「未跟踪」文件生效；已跟踪文件需 git rm --cached
# ============================================================
data/*
# 例外 1：公开的 CA 证书（**公开证书，不含私钥**，TLS 握手必需 ⇒ 必须能提交）
!data/emqxsl-ca.crt
# 例外 2：配置模板（只含字段结构与占位值，不含任何真实凭据）
#   data/ 与 data/config/* 被整体忽略 ⇒ 先放行目录，再放行 *.json.example
!data/config/
data/config/*
!data/config/*.json.example
!data/config/README.md
!data/workflow.json.example

# ============================================================
# 内部工程约定（AI 协作规则 / 个人工作偏好），不属于开源内容
#   ★ 历史注释曾写「含真实 MQTT 凭据」—— 实测当前与历史版本均**不含**任何凭据；
#     保留忽略是因为它是私人工程约定，而非因为敏感信息。
# ============================================================
AI_RULES.md

# ============================================================
# 本地工具目录（代码索引 / 工作记忆，机器相关）
# ============================================================
.workbuddy/
.codegraph/

# ============================================================
# 误操作 / 临时产物
# ============================================================
et --hard *
*.tmp
*.bak
*~
# GCC 依赖文件（首行形如 "xxx.o: src\\xxx.cpp \\"）
# ⚠️ 2026-10-01：仓库根目录曾误入 4 个此类文件（cloud_manager.d 等），
#    它们是构建产物而非设计文档，已删除并在此拦截。
*.d

# ============================================================
# 固件产物归档（每个 .bin 约 1.4 MB，可再生成；追溯依据是 manifest 里的 SHA）
# 需要保留时用 tools/archive_build_artifacts.sh 重新生成
# ============================================================
docs/evidence/build-archive/
