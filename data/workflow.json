{
    "workflows": [
        {
            "id": "wf_timer",
            "name": "Timer Test (expired)",
            "enable": true,
            "timeout_ms": 600000,
            "steps": [
                {
                    "type": "trigger",
                    "id": "timer",
                    "params": {
                        "type": "once",
                        "hour": 0,
                        "minute": 0,
                        "year": 2000,
                        "month": 1,
                        "day": 1
                    }
                },
                {
                    "type": "action",
                    "id": "test.action",
                    "params": {
                        "value": 100
                    }
                }
            ]
        },
        {
            "id": "wf_delay",
            "name": "Delay Test (3s)",
            "enable": true,
            "timeout_ms": 600000,
            "steps": [
                {
                    "type": "trigger",
                    "id": "delay",
                    "params": {
                        "seconds": 3
                    }
                },
                {
                    "type": "action",
                    "id": "test.action",
                    "params": {
                        "value": 200
                    }
                }
            ]
        }
    ]
}